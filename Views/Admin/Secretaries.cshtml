@using HemaSense.Models
@model IEnumerable<Secretary>
@{
    ViewData["Title"] = "Manage Secretaries";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var user = ViewBag.User as SessionUser;
    var list = Model.ToList();
}

@section Styles {
<link rel="stylesheet" href="~/css/app.css" />
<style>
    .admin-panel {
        display: grid;
        grid-template-columns: 360px 1fr;
        gap: 24px;
        align-items: start;
    }
    @@media (max-width: 1100px) { .admin-panel { grid-template-columns: 1fr; } }

    /* ── Add card ── */
    .add-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        position: sticky;
        top: 24px;
    }
    .add-card-header {
        background: linear-gradient(135deg, #3b82f6 0%, #55aef7 100%);
        padding: 22px 24px;
        color: white;
    }
    .add-card-header h3 {
        font-size: 16px; font-weight: 700;
        display: flex; align-items: center; gap: 9px;
        margin: 0;
    }
    .add-card-body { padding: 24px; }
    .add-card-body .form-group { margin-bottom: 16px; }
    .add-card-body label {
        display: block; font-size: 13px; font-weight: 600;
        color: var(--text-primary); margin-bottom: 6px;
    }
    .add-card-body input {
        width: 100%; padding: 11px 14px;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        font-size: 14px; color: var(--text-primary);
        transition: all .2s; background: white;
    }
    .add-card-body input:focus {
        outline: none; border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(58, 142, 237, 0.1);
    }
    .btn-add {
        width: 100%; padding: 12px;
        background: #3b82f6; color: white;
        border: none; border-radius: var(--radius-md);
        font-size: 14px; font-weight: 600; cursor: pointer;
        transition: all .2s; display: flex; align-items: center;
        justify-content: center; gap: 8px;
    }
    .btn-add:hover { background: #3b82f6; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(58, 142, 237, 0.35); }

    /* ── List card ── */
    .list-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }
    .list-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid var(--border-color);
        display: flex; align-items: center;
        justify-content: space-between; flex-wrap: wrap; gap: 10px;
    }
    .list-card-header h3 {
        font-size: 16px; font-weight: 700; color: var(--text-primary);
        display: flex; align-items: center; gap: 9px; margin: 0;
    }
    .count-badge {
        background: #f5f3ff; color: #3b82f6;
        border-radius: 100px; padding: 3px 12px;
        font-size: 13px; font-weight: 700;
    }
    .search-inline input {
        padding: 8px 14px; border: 1px solid var(--border-color);
        border-radius: var(--radius-md); font-size: 13px;
        width: 220px; transition: all .2s;
    }
    .search-inline input:focus { outline: none; border-color: #3b82f6; }

    /* ── Avatar ── */
    .avatar {
        width: 38px; height: 38px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 15px; font-weight: 700; color: white; flex-shrink: 0;
    }
    .avatar-purple { background: linear-gradient(135deg,#3b82f6,#3b82f6); }
    .avatar-blue   { background: linear-gradient(135deg,#2563eb,#3b82f6); }

    /* ── Row actions ── */
    .row-actions { display: flex; gap: 6px; }
    .btn-row-edit {
        padding: 6px 14px; font-size: 12px; font-weight: 600;
        background: rgba(245,158,11,.1); color: #b45309;
        border: 1px solid rgba(245,158,11,.25);
        border-radius: var(--radius-sm); cursor: pointer;
        transition: all .2s; display: inline-flex; align-items: center; gap: 5px;
        text-decoration: none;
    }
    .btn-row-edit:hover { background: rgba(245,158,11,.2); transform: translateY(-1px); }
    .btn-row-delete {
        padding: 6px 14px; font-size: 12px; font-weight: 600;
        background: rgba(239,68,68,.08); color: #b91c1c;
        border: 1px solid rgba(239,68,68,.2);
        border-radius: var(--radius-sm); cursor: pointer;
        transition: all .2s; display: inline-flex; align-items: center; gap: 5px;
    }
    .btn-row-delete:hover { background: rgba(239,68,68,.18); transform: translateY(-1px); }

    .empty-row td {
        text-align: center; padding: 50px;
        color: var(--text-muted); font-size: 14px;
    }
    .pw-mask { font-family: monospace; letter-spacing: 2px; color: var(--text-muted); font-size: 13px; }
</style>
}

<div class="container">
    @await Html.PartialAsync("_Sidebar")

    <div class="main-content">
        <div class="header">
            <div>
                <h1><i class="fa-solid fa-user-tie" style="color:#3a8eed;font-size:22px;margin-right:10px;"></i>Manage Secretaries</h1>
                <div style="font-size:13px;color:var(--text-muted);margin-top:3px;">Add, edit or remove secretary accounts.</div>
            </div>
            <div class="header-right">
                <div class="user-icon">
                    <i class="fa-solid fa-user-doctor"></i>
                    <span>Dr. @user?.Name</span>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert-success"><i class="fa-solid fa-check-circle"></i> @TempData["Success"]</div>
        }
        @if (TempData["SecError"] != null)
        {
            <div class="alert-danger"><i class="fa-solid fa-triangle-exclamation"></i> @TempData["SecError"]</div>
        }

        <div class="admin-panel">

            <div class="add-card">
                <div class="add-card-header">
                    <h3><i class="fa-solid fa-user-plus"></i> Add New Secretary</h3>
                </div>
                <div class="add-card-body">
                    <form asp-action="CreateSecretary" asp-controller="Admin" method="post">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label>Full Name</label>
                            <input type="text" name="Name" placeholder="e.g. Sara Ahmed" required autocomplete="off" />
                        </div>
                        <div class="form-group">
                            <label>Username</label>
                            <input type="text" name="Username" placeholder="e.g. sara.ahmed" required autocomplete="off" />
                        </div>
                        <div class="form-group">
                            <label>Password</label>
                            <input type="text" name="Password" placeholder="Initial password" required autocomplete="off" />
                        </div>
                        <button type="submit" class="btn-add">
                            <i class="fa-solid fa-plus"></i> Add Secretary
                        </button>
                    </form>
                </div>
            </div>

            <div class="list-card">
                <div class="list-card-header">
                    <h3><i class="fa-solid fa-list-ul" style="color:#3a79ed;"></i> All Secretaries
                        <span class="count-badge" id="secCount">@list.Count</span>
                    </h3>
                    <div class="search-inline">
                        <input type="text" id="searchInput" placeholder="Search name…" oninput="filterRows()" />
                    </div>
                </div>

                <div style="overflow-x:auto;">
                    <table id="secTable">
                        <thead>
                            <tr>
                                <th style="width:50px;">ID</th>
                                <th>Secretary</th>
                                <th>Username</th>
                                <th>Password</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="secBody">
                            @if (!list.Any())
                            {
                                <tr class="empty-row">
                                    <td colspan="5">
                                        <i class="fa-solid fa-users-slash" style="font-size:32px;display:block;margin-bottom:10px;opacity:.3;"></i>
                                        No secretaries yet. Add one using the form.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var s in list)
                                {
                                    <tr class="sec-row" data-name="@s.Name.ToLower()">
                                        <td><span style="font-size:12px;font-weight:700;color:#3a79ed;background:#f5f3ff;padding:3px 8px;border-radius:6px;">#@s.SecretaryId</span></td>
                                        <td>
                                            <div style="display:flex;align-items:center;gap:10px;">
                                                <div class="avatar avatar-purple">@s.Name[0].ToString().ToUpper()</div>
                                                <strong>@s.Name</strong>
                                            </div>
                                        </td>
                                        <td style="color:var(--text-secondary);font-size:13px;">@@s.Username</td>
                                        <td><span class="pw-mask">••••••••</span></td>
                                        <td>
                                            <div class="row-actions">
                                                <a href="@Url.Action("EditSecretary","Admin",new{id=s.SecretaryId})" class="btn-row-edit">
                                                    <i class="fa-solid fa-pen"></i> Edit
                                                </a>
                                                <form asp-action="DeleteSecretary" asp-controller="Admin" asp-route-id="@s.SecretaryId" method="post" style="display:inline"
                                                      onsubmit="return confirm('Delete @s.Name? This cannot be undone.')">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn-row-delete">
                                                        <i class="fa-solid fa-trash"></i> Delete
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
    function filterRows() {
        const term = document.getElementById('searchInput').value.toLowerCase();
        let count  = 0;
        document.querySelectorAll('.sec-row').forEach(r => {
            const match = r.dataset.name.includes(term);
            r.style.display = match ? '' : 'none';
            if (match) count++;
        });
        document.getElementById('secCount').textContent = count;
    }
</script>
}
