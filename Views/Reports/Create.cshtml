@using HemaSense.Models
@model Report
@{
    ViewData["Title"] = "Create Medical Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var patient = ViewBag.Patient as Patient;
    var user    = ViewBag.User    as SessionUser;
    var predictUrl = Url.Action("Predict", "Reports");
}

@section Styles {
<link rel="stylesheet" href="~/css/app.css" />
<style>
    .patient-info-header {
        background: white;
        padding: 28px;
        border-radius: 16px;
        margin-bottom: 24px;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
        border: 1px solid #e2e8f0;
    }
    .patient-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 20px;
    }
    .info-label-s { font-size: 12px; color: #64748b; font-weight: 600; text-transform: uppercase; }
    .info-value-s { font-size: 18px; font-weight: 700; color: #1e293b; }
    .cbc-section {
        background: white;
        padding: 36px;
        border-radius: 16px;
        margin-bottom: 24px;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
        border: 1px solid #e2e8f0;
    }
    .cbc-section h2 {
        font-size: 20px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 28px;
        padding-bottom: 16px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .cbc-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .cbc-input-group { display: flex; flex-direction: column; gap: 8px; }
    .cbc-input-group label { font-size: 14px; font-weight: 600; color: #1e293b; display: flex; align-items: center; justify-content: space-between; }
    .unit { font-size: 12px; color: #94a3b8; background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-weight: 400; }
    .cbc-input-group input { padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 12px; font-size: 16px; transition: all .2s; }
    .cbc-input-group input:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px #eff6ff; }
    .action-footer { display: flex; gap: 16px; justify-content: flex-end; flex-wrap: wrap; margin-top: 36px; padding-top: 24px; border-top: 1px solid #e2e8f0; }
    .action-btn { display: flex; align-items: center; gap: 10px; padding: 14px 24px; border: none; border-radius: 12px; font-size: 15px; font-weight: 600; cursor: pointer; transition: all .2s; color: white; text-decoration: none; }
    .action-btn-predict { background: #3b82f6; box-shadow: 0 4px 6px -1px rgba(59,130,246,.4); }
    .action-btn-predict:hover { background: #2563eb; transform: translateY(-2px); }
    .action-btn-save { background: #10b981; }
    .action-btn-save:hover { background: #059669; transform: translateY(-2px); }
    .action-btn-print { background: #64748b; }
    .action-btn-print:hover { background: #475569; }
    /* Prediction Modal */
    .prediction-modal { display: none; position: fixed; z-index: 1000; inset: 0; background: rgba(0,0,0,.5); backdrop-filter: blur(4px); align-items: center; justify-content: center; }
    .prediction-modal.show { display: flex; }
    .prediction-content { background: white; padding: 40px; border-radius: 24px; max-width: 480px; width: 90%; text-align: center; animation: fadeInUp .4s ease-out; }
    @@keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
    .prediction-icon { font-size: 60px; color: #3b82f6; margin-bottom: 16px; }
    .diagnosis-label { font-size: 20px; font-weight: 700; padding: 12px 24px; border-radius: 12px; display: inline-block; margin: 12px 0; }
    .diagnosis-normal   { background: #dcfce7; color: #166534; }
    .diagnosis-warning  { background: #fef3c7; color: #92400e; }
    .diagnosis-critical { background: #fee2e2; color: #b91c1c; }
    .confidence-bar { width: 100%; height: 8px; background: #e2e8f0; border-radius: 4px; overflow: hidden; margin: 16px 0; }
    .confidence-fill { height: 100%; background: #3b82f6; transition: width .6s ease; }
    .confidence-text { font-size: 15px; font-weight: 600; color: #3b82f6; margin-bottom: 16px; }
    .close-modal-btn { padding: 12px 32px; background: #f1f5f9; border: none; border-radius: 12px; font-size: 15px; font-weight: 600; cursor: pointer; color: #1e293b; transition: background .2s; margin-right: 10px; }
    .use-diagnosis-btn { padding: 12px 32px; background: #10b981; border: none; border-radius: 12px; font-size: 15px; font-weight: 600; cursor: pointer; color: white; transition: background .2s; }
    .use-diagnosis-btn:hover { background: #059669; }
    .chat-section { background: white; padding: 36px; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
    .chat-section h2 { font-size: 20px; font-weight: 700; color: #1e293b; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 12px; }
    .chat-window { height: 340px; overflow-y: auto; padding: 16px; background: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; gap: 14px; }
    .chat-message { display: flex; gap: 10px; animation: fadeIn .3s ease; }
    .chat-message.user { flex-direction: row-reverse; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    .chat-avatar { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 14px; }
    .chat-message.assistant .chat-avatar { background: #3b82f6; color: white; }
    .chat-message.user      .chat-avatar { background: #10b981; color: white; }
    .chat-bubble { max-width: 75%; padding: 10px 14px; border-radius: 12px; font-size: 14px; line-height: 1.5; }
    .chat-message.assistant .chat-bubble { background: white; border: 1px solid #e2e8f0; border-top-left-radius: 2px; }
    .chat-message.user .chat-bubble { background: #3b82f6; color: white; border-top-right-radius: 2px; }
    .chat-input-row { display: flex; gap: 12px; padding: 14px; background: white; border: 1px solid #e2e8f0; border-radius: 0 0 12px 12px; border-top: none; }
    #chatInput { flex: 1; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 14px; background: #f8fafc; }
    #chatInput:focus { outline: none; border-color: #3b82f6; background: white; }
    .chat-send-btn { padding: 0 20px; background: #3b82f6; color: white; border: none; border-radius: 10px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px; transition: background .2s; }
    .chat-send-btn:hover { background: #2563eb; }
    @@media (max-width: 768px) { .cbc-grid { grid-template-columns: 1fr; } }
</style>
}

<div class="container">
    @await Html.PartialAsync("_Sidebar")
    <div class="main-content">
        <div class="header">
            <h1>Create Medical Report</h1>
            <div class="header-right">
                <a href="@Url.Action("Pending")" style="color:#3b82f6;font-weight:600;text-decoration:none;display:flex;align-items:center;gap:8px;">
                    <i class="fa-solid fa-arrow-left"></i> Back to List
                </a>
            </div>
        </div>

        @if (patient != null)
        {
            <div class="patient-info-header">
                <div class="patient-info-grid">
                    <div>
                        <div class="info-label-s">Patient ID</div>
                        <div class="info-value-s">#@patient.PatientId.ToString("D3")</div>
                    </div>
                    <div>
                        <div class="info-label-s">Name</div>
                        <div class="info-value-s">@patient.Name</div>
                    </div>
                    <div>
                        <div class="info-label-s">Age</div>
                        <div class="info-value-s">@patient.Age years</div>
                    </div>
                    <div>
                        <div class="info-label-s">Phone</div>
                        <div class="info-value-s">@patient.Phone</div>
                    </div>
                    <div>
                        <div class="info-label-s">Date</div>
                        <div class="info-value-s">@(patient.NowDate.HasValue ? patient.NowDate.Value.ToString("MMM dd, yyyy") : DateTime.Now.ToString("MMM dd, yyyy"))</div>
                    </div>
                </div>
            </div>
        }

        <form asp-action="Create" asp-controller="Reports" method="post" id="reportForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PatientId" value="@(patient?.PatientId ?? 0)" />

            <div class="cbc-section">
                <h2><i class="fa-solid fa-flask" style="color:#3b82f6;"></i> Complete Blood Count (CBC) Values</h2>

                <div class="cbc-grid">
                    <div class="cbc-input-group">
                        <label asp-for="WBC">WBC (White Blood Cells) <span class="unit">10³/µL</span></label>
                        <input asp-for="WBC" type="number" step="0.01" placeholder="4.5 – 11.0" id="inp_wbc" />
                    </div>
                    <div class="cbc-input-group">
                        <label asp-for="RBC">RBC (Red Blood Cells) <span class="unit">10⁶/µL</span></label>
                        <input asp-for="RBC" type="number" step="0.01" placeholder="4.5 – 5.9" id="inp_rbc" />
                    </div>
                    <div class="cbc-input-group">
                        <label asp-for="HGB">HGB (Hemoglobin) <span class="unit">g/dL</span></label>
                        <input asp-for="HGB" type="number" step="0.01" placeholder="13.5 – 17.5" id="inp_hgb" />
                    </div>
                    <div class="cbc-input-group">
                        <label asp-for="HCT">HCT (Hematocrit) <span class="unit">%</span></label>
                        <input asp-for="HCT" type="number" step="0.01" placeholder="38.8 – 50.0" id="inp_hct" />
                    </div>
                    <div class="cbc-input-group">
                        <label asp-for="MCV">MCV (Mean Corpuscular Volume) <span class="unit">fL</span></label>
                        <input asp-for="MCV" type="number" step="0.01" placeholder="80 – 100" id="inp_mcv" />
                    </div>
                    <div class="cbc-input-group">
                        <label asp-for="MCH">MCH (Mean Corpuscular Hemoglobin) <span class="unit">pg</span></label>
                        <input asp-for="MCH" type="number" step="0.01" placeholder="27 – 33" id="inp_mch" />
                    </div>
                    <div class="cbc-input-group">
                        <label asp-for="MCHC">MCHC (Mean Corpuscular Hgb Concentration) <span class="unit">g/dL</span></label>
                        <input asp-for="MCHC" type="number" step="0.01" placeholder="32 – 36" id="inp_mchc" />
                    </div>
                    <div class="cbc-input-group">
                        <label asp-for="PLT">PLT (Platelets) <span class="unit">10³/µL</span></label>
                        <input asp-for="PLT" type="number" step="0.01" placeholder="150 – 400" id="inp_plt" />
                    </div>
                </div>

                <div class="cbc-input-group" style="margin-top:24px;">
                    <label asp-for="Diagnosis">Diagnosis</label>
                    <input asp-for="Diagnosis" id="diagnosisInput" placeholder="Use 'Predict Diagnosis' or enter manually" />
                    <span asp-validation-for="Diagnosis" class="text-danger"></span>
                </div>

                <div class="action-footer">
                    <button type="button" class="action-btn action-btn-predict" id="predictBtn">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> Predict Diagnosis
                    </button>
                    <a href="@Url.Action("Print","Reports", new{id=patient?.PatientId})" class="action-btn action-btn-print">
                        <i class="fa-solid fa-print"></i> Print Preview
                    </a>
                    <button type="submit" class="action-btn action-btn-save">
                        <i class="fa-solid fa-floppy-disk"></i> Save Report
                    </button>
                </div>
            </div>
        </form>

        <!-- AI Chat Section -->
        <div class="chat-section">
            <h2><i class="fa-solid fa-robot" style="color:#3b82f6;"></i> Medical AI Assistant</h2>
            <div style="border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;">
                <div class="chat-window" id="chatWindow"></div>
                <div class="chat-input-row">
                    <input id="chatInput" type="text" placeholder="Ask about test results, diagnosis, or medical advice..." />
                    <button id="sendBtn" class="chat-send-btn"><i class="fa-solid fa-paper-plane"></i> Send</button>
                </div>
                <div style="padding:10px 16px;background:#fffbeb;color:#b45309;font-size:12px;font-weight:500;display:flex;align-items:center;gap:8px;border-top:1px solid #fcd34d;">
                    <i class="fa-solid fa-triangle-exclamation"></i> Educational purposes only. Not a substitute for professional diagnosis.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Prediction Modal -->
<div class="prediction-modal" id="predictionModal">
    <div class="prediction-content">
        <div id="loadingContent" style="padding:30px;">
            <div class="loading-spinner-lg"></div>
            <p style="margin-top:16px;color:#64748b;">Analyzing CBC values...</p>
        </div>
        <div id="predictionResult" style="display:none;">
            <div class="prediction-icon"><i class="fa-solid fa-microscope"></i></div>
            <h2>Diagnosis Result</h2>
            <div class="diagnosis-label diagnosis-normal" id="diagnosisLabel">Normal</div>
            <div class="confidence-text" id="confidenceText">Confidence: 95%</div>
            <div class="confidence-bar"><div class="confidence-fill" id="confidenceFill" style="width:95%"></div></div>
            <div>
                <button class="close-modal-btn" id="closeModalBtn">Close</button>
                <button class="use-diagnosis-btn" id="useDiagnosisBtn">Use This Diagnosis</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const predictUrl   = '@predictUrl';
    let lastDiagnosis  = '';

    // ── Prediction ───────────────────────────────────────────────────
    document.getElementById('predictBtn').addEventListener('click', async () => {
        const data = {
            WBC:  parseFloat(document.getElementById('inp_wbc').value)  || 0,
            RBC:  parseFloat(document.getElementById('inp_rbc').value)   || 0,
            HGB:  parseFloat(document.getElementById('inp_hgb').value)   || 0,
            HCT:  parseFloat(document.getElementById('inp_hct').value)   || 0,
            MCV:  parseFloat(document.getElementById('inp_mcv').value)   || 0,
            MCH:  parseFloat(document.getElementById('inp_mch').value)   || 0,
            MCHC: parseFloat(document.getElementById('inp_mchc').value)  || 0,
            PLT:  parseFloat(document.getElementById('inp_plt').value)   || 0,
        };

        showModal(true);

        try {
            const res  = await fetch(predictUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const json = await res.json();
            lastDiagnosis = json.diagnosis;

            const pct  = Math.round((json.confidence || 0) * 100);
            const label = document.getElementById('diagnosisLabel');
            label.textContent = json.diagnosis;
            label.className   = 'diagnosis-label ' + (pct >= 85 ? 'diagnosis-normal' : pct >= 70 ? 'diagnosis-warning' : 'diagnosis-critical');

            document.getElementById('confidenceText').textContent = `Confidence: ${pct}%`;
            document.getElementById('confidenceFill').style.width = `${pct}%`;

            showModal(false);
        } catch (err) {
            console.error(err);
            showModal(false, true);
        }
    });

    function showModal(loading, err = false) {
        document.getElementById('predictionModal').classList.add('show');
        document.getElementById('loadingContent').style.display  = loading ? 'block' : 'none';
        document.getElementById('predictionResult').style.display = loading ? 'none' : 'block';
    }

    document.getElementById('closeModalBtn').addEventListener('click', () => {
        document.getElementById('predictionModal').classList.remove('show');
    });

    document.getElementById('useDiagnosisBtn').addEventListener('click', () => {
        document.getElementById('diagnosisInput').value = lastDiagnosis;
        document.getElementById('predictionModal').classList.remove('show');
    });

    // ── AI Chat (Streaming from Python LLM server) ──
    const chatWindow = document.getElementById('chatWindow');
    const chatInput  = document.getElementById('chatInput');
    const sendBtn = document.getElementById('sendBtn');
    let isGenerating = false;

    function addMessage(role, text) {
        const div = document.createElement('div');
        div.className = `chat-message ${role}`;
        const icon = role === 'assistant' ? 'fa-robot' : 'fa-user';
        const bg   = role === 'assistant' ? '#3b82f6'  : '#10b981';
        div.innerHTML = `
            <div class="chat-avatar" style="background:${bg};color:white;"><i class="fa-solid ${icon}"></i></div>
            <div class="chat-bubble"></div>`;
        
        // Use textContent to avoid XSS if text is not HTML
        const bubble = div.querySelector('.chat-bubble');
        bubble.textContent = text;
        
        chatWindow.appendChild(div);
        chatWindow.scrollTop = chatWindow.scrollHeight;
        return bubble; // Return the text container so we can update it in streaming
    }

    addMessage('assistant', 'Hello! I\'m your medical AI assistant powered by SciReason. I can help you interpret CBC results and provide medical guidance based on the current patient values.');

    sendBtn.addEventListener('click', sendChat);
    chatInput.addEventListener('keydown', e => { if (e.key === 'Enter') sendChat(); });

    async function sendChat() {
        if (isGenerating) return;
        
        const msg = chatInput.value.trim();
        if (!msg) return;
        
        addMessage('user', msg);
        chatInput.value = '';
        
        const cbcData = {
            WBC:  parseFloat(document.getElementById('inp_wbc').value)  || 0,
            RBC:  parseFloat(document.getElementById('inp_rbc').value)   || 0,
            HGB:  parseFloat(document.getElementById('inp_hgb').value)   || 0,
            HCT:  parseFloat(document.getElementById('inp_hct').value)   || 0,
            MCV:  parseFloat(document.getElementById('inp_mcv').value)   || 0,
            MCH:  parseFloat(document.getElementById('inp_mch').value)   || 0,
            MCHC: parseFloat(document.getElementById('inp_mchc').value)  || 0,
            PLT:  parseFloat(document.getElementById('inp_plt').value)   || 0,
        };

        const payload = {
            prompt: msg,
            cbc_data: cbcData
        };

        isGenerating = true;
        sendBtn.disabled = true;
        
        // Create an empty assistant message bubble to fill
        const bubbleNode = addMessage('assistant', '...');
        bubbleNode.textContent = ''; // clear the "..."

        try {
            const response = await fetch('http://127.0.0.1:7500/api/ai/diagnosis/stream', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                throw new Error(`Server responded with ${response.status}`);
            }

            const reader = response.body.getReader();
            const decoder = new TextDecoder("utf-8");

            while (true) {
                const { done, value } = await reader.read();
                if (done) break;
                
                const chunk = decoder.decode(value, { stream: true });
                bubbleNode.textContent += chunk;
                chatWindow.scrollTop = chatWindow.scrollHeight;
            }
        } catch (err) {
            console.error('Chat error:', err);
            bubbleNode.textContent += `\n[Error communicating with AI server: ${err.message}]`;
        } finally {
            isGenerating = false;
            sendBtn.disabled = false;
            chatInput.focus();
        }
    }
</script>

<style>
.loading-spinner-lg {
    width: 50px; height: 50px;
    border: 4px solid #f3f3f3;
    border-top: 4px solid #3b82f6;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto;
}
@@keyframes spin { 0%{transform:rotate(0deg);} 100%{transform:rotate(360deg);} }
</style>
}
