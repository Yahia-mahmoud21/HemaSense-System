@using HemaSense.Models
@{
    ViewData["Title"] = "Medical Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var patient = ViewBag.Patient as Patient;
    var report  = ViewBag.Report  as Report;
}

@section Styles {
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', 'Segoe UI', sans-serif; background: #f1f5f9; padding: 20px; }
    .print-actions { text-align: center; margin: 20px 0; }
    .print-btn {
        padding: 12px 24px; background: #3b82f6; color: white; border: none;
        border-radius: 10px; font-size: 15px; font-weight: 600; cursor: pointer;
        transition: all .2s; display: inline-flex; align-items: center; gap: 8px;
        box-shadow: 0 4px 6px -1px rgba(59,130,246,.4);
    }
    .print-btn:hover { background: #2563eb; transform: translateY(-1px); }
    .back-btn {
        padding: 12px 24px; background: white; color: #475569; border: 1px solid #cbd5e1;
        border-radius: 10px; font-size: 15px; font-weight: 600; cursor: pointer;
        text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
        margin-right: 12px; transition: all .2s;
    }
    .back-btn:hover { background: #f8fafc; color: #1e293b; }
    .print-container { max-width: 210mm; margin: 0 auto; background: white; box-shadow: 0 4px 6px -1px rgba(0,0,0,.1); }
    .a4-page { width: 210mm; min-height: 297mm; padding: 20mm; background: white; position: relative; }
    .report-header { text-align: center; border-bottom: 2px solid #3b82f6; padding-bottom: 20px; margin-bottom: 30px; }
    .lab-logo { font-size: 40px; color: #3b82f6; margin-bottom: 10px; }
    .lab-name { font-size: 24px; font-weight: 700; color: #1e293b; margin-bottom: 4px; }
    .lab-subtitle { font-size: 14px; color: #64748b; margin-bottom: 8px; }
    .lab-contact { font-size: 12px; color: #94a3b8; }
    .section-title { font-size: 15px; font-weight: 700; color: #1e293b; margin-bottom: 14px; padding-bottom: 8px; border-bottom: 1px solid #e2e8f0; text-transform: uppercase; letter-spacing: .5px; }
    .patient-section { margin-bottom: 28px; }
    .patient-info-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .info-row { display: flex; padding: 4px 0; }
    .info-label { font-weight: 600; color: #475569; min-width: 120px; font-size: 14px; }
    .info-value { color: #1e293b; font-size: 14px; }
    .cbc-table { width: 100%; border-collapse: collapse; margin-bottom: 28px; }
    .cbc-table th { background: #f8fafc; color: #475569; padding: 12px; text-align: center; font-weight: 600; font-size: 13px; border-bottom: 2px solid #e2e8f0; text-transform: uppercase; }
    .cbc-table td { padding: 12px; border-bottom: 1px solid #e2e8f0; font-size: 14px; text-align: center; }
    .test-name { font-weight: 600; color: #1e293b; }
    .test-value { color: #3b82f6; font-weight: 700; }
    .diagnosis-section { background: #f8fafc; padding: 20px; border-radius: 10px; margin-bottom: 28px; border-left: 4px solid #3b82f6; }
    .diagnosis-section h3 { font-size: 16px; font-weight: 700; color: #1e293b; margin-bottom: 8px; }
    .diagnosis-result { font-size: 18px; font-weight: 600; color: #3b82f6; }
    .signature-section { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 60px; }
    .signature-box { text-align: center; }
    .signature-line { border-top: 1px solid #94a3b8; margin: 40px auto 8px; width: 80%; }
    .signature-label { font-size: 13px; color: #64748b; font-weight: 600; text-transform: uppercase; }
    .report-footer { position: absolute; bottom: 20mm; left: 20mm; right: 20mm; text-align: center; padding-top: 15px; border-top: 1px solid #e2e8f0; font-size: 11px; color: #94a3b8; }
    @@media print {
        body { background: white; padding: 0; }
        .print-actions { display: none; }
        .print-container { box-shadow: none; }
        .a4-page { padding: 15mm; width: 100%; min-height: auto; }
    }
</style>
}

<div class="print-actions">
    <a onclick="window.history.back()" class="back-btn"><i class="fa-solid fa-arrow-left"></i> Back</a>
    <button onclick="window.print()" class="print-btn"><i class="fa-solid fa-print"></i> Print Report</button>
</div>

<div class="print-container">
    <div class="a4-page">
        <!-- Header -->
        <div class="report-header">
            <div class="lab-logo"><i class="fa-solid fa-flask-vial"></i></div>
            <div class="lab-name">HemaSense</div>
            <div class="lab-subtitle">Laboratory Report Management System</div>
            <div class="lab-contact">
                <i class="fa-solid fa-phone" style="font-size:10px;"></i> +20 123 456 7890 |
                <i class="fa-solid fa-envelope" style="font-size:10px;"></i> info@hemasense.com |
                <i class="fa-solid fa-location-dot" style="font-size:10px;"></i> Cairo, Egypt
            </div>
        </div>

        <!-- Patient Info -->
        <div class="patient-section">
            <h2 class="section-title">Patient Information</h2>
            <div class="patient-info-grid">
                <div class="info-row">
                    <span class="info-label">Patient ID:</span>
                    <span class="info-value">#@(patient?.PatientId.ToString("D3") ?? "---")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Date:</span>
                    <span class="info-value">@(patient?.NowDate.HasValue == true ? patient.NowDate.Value.ToString("MMMM dd, yyyy") : DateTime.Now.ToString("MMMM dd, yyyy"))</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Patient Name:</span>
                    <span class="info-value">@(patient?.Name ?? "N/A")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Age:</span>
                    <span class="info-value">@(patient != null ? $"{patient.Age} years" : "N/A")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Phone:</span>
                    <span class="info-value">@(patient?.Phone ?? "N/A")</span>
                </div>
            </div>
        </div>

        <!-- CBC Results -->
        <div>
            <h2 class="section-title">Complete Blood Count (CBC) Results</h2>
            @if (report != null)
            {
                <table class="cbc-table">
                    <thead>
                        <tr><th>Test</th><th>Result</th><th>Unit</th><th>Reference Range</th></tr>
                    </thead>
                    <tbody>
                        <tr><td class="test-name">WBC</td><td class="test-value">@report.WBC</td><td style="color:#94a3b8;">10³/µL</td><td style="color:#64748b;">4.5 – 11.0</td></tr>
                        <tr><td class="test-name">RBC</td><td class="test-value">@report.RBC</td><td style="color:#94a3b8;">10⁶/µL</td><td style="color:#64748b;">4.5 – 5.9</td></tr>
                        <tr><td class="test-name">HGB</td><td class="test-value">@report.HGB</td><td style="color:#94a3b8;">g/dL</td><td style="color:#64748b;">13.5 – 17.5</td></tr>
                        <tr><td class="test-name">HCT</td><td class="test-value">@report.HCT</td><td style="color:#94a3b8;">%</td><td style="color:#64748b;">38.8 – 50.0</td></tr>
                        <tr><td class="test-name">MCV</td><td class="test-value">@report.MCV</td><td style="color:#94a3b8;">fL</td><td style="color:#64748b;">80 – 100</td></tr>
                        <tr><td class="test-name">MCH</td><td class="test-value">@report.MCH</td><td style="color:#94a3b8;">pg</td><td style="color:#64748b;">27 – 33</td></tr>
                        <tr><td class="test-name">MCHC</td><td class="test-value">@report.MCHC</td><td style="color:#94a3b8;">g/dL</td><td style="color:#64748b;">32 – 36</td></tr>
                        <tr><td class="test-name">PLT</td><td class="test-value">@report.PLT</td><td style="color:#94a3b8;">10³/µL</td><td style="color:#64748b;">150 – 400</td></tr>
                    </tbody>
                </table>

                <div class="diagnosis-section">
                    <h3><i class="fa-solid fa-stethoscope"></i> Diagnosis</h3>
                    <div class="diagnosis-result">@report.Diagnosis</div>
                </div>
            }
            else
            {
                <p style="color:#94a3b8;font-style:italic;">No report data available yet.</p>
            }
        </div>

        <!-- Signatures -->
        <div class="signature-section">
            <div class="signature-box">
                <div class="signature-line"></div>
                <div class="signature-label">Laboratory Technician</div>
            </div>
            <div class="signature-box">
                <div class="signature-line"></div>
                <div class="signature-label">Authorized Doctor</div>
            </div>
        </div>

        <!-- Footer -->
        <div class="report-footer">
            <p>This report is generated by HemaSense – Laboratory Report Management System</p>
            <p>Report Date: @DateTime.Now.ToString("MMMM dd, yyyy")</p>
        </div>
    </div>
</div>
