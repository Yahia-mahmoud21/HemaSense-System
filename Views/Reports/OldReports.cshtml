@using HemaSense.Models
@model IEnumerable<Report>
@{
    ViewData["Title"] = "Patient Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var user     = ViewBag.User     as SessionUser;
    int offset   = (int)(ViewBag.Offset   ?? 0);
    int pageSize = (int)(ViewBag.PageSize  ?? 10);
    bool hasMore = (bool)(ViewBag.HasMore  ?? false);
    int total    = (int)(ViewBag.Total    ?? 0);
    var list     = Model.ToList();
}

@section Styles {
<link rel="stylesheet" href="~/css/app.css" />
<style>
    /* ── page-level tweaks ── */
    .report-card-header {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        padding: 28px 32px;
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
    }
    .report-card-header h2 {
        font-size: 20px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
    }
    .report-card-header .subtitle { font-size: 13px; opacity: .8; margin-top: 3px; }

    .search-bar-wrap {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: 18px 24px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        box-shadow: var(--shadow-sm);
    }
    .search-bar-wrap .search-box { flex: 1; min-width: 240px; }
    .search-bar-wrap .search-box input { width: 100%; }

    .diag-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #eff6ff;
        color: #1d4ed8;
        border-radius: 6px;
        padding: 3px 10px;
        font-size: 12px;
        font-weight: 600;
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .id-chip {
        font-size: 12px; font-weight: 700;
        color: var(--primary-color);
        background: var(--primary-light);
        border-radius: 6px;
        padding: 3px 8px;
    }
    .report-id-chip {
        font-size: 12px; font-weight: 700;
        color: #7c3aed;
        background: #f5f3ff;
        border-radius: 6px;
        padding: 3px 8px;
    }
    .cbc-mini {
        display: flex; gap: 8px; flex-wrap: wrap;
    }
    .cbc-pill {
        font-size: 11px;
        background: #f8fafc;
        border: 1px solid var(--border-color);
        border-radius: 5px;
        padding: 2px 7px;
        color: var(--text-secondary);
        font-weight: 600;
        white-space: nowrap;
    }
    .cbc-pill span { color: var(--text-primary); }

    .btn-edit-report {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 8px 16px;
        background: #f59e0b; color: white;
        border-radius: var(--radius-sm);
        font-size: 13px; font-weight: 600;
        transition: all .2s; border: none; cursor: pointer;
        text-decoration: none;
        box-shadow: 0 2px 4px rgba(245,158,11,.3);
    }
    .btn-edit-report:hover { background: #d97706; transform: translateY(-2px); box-shadow: 0 4px 8px rgba(245,158,11,.3); }

    .btn-print-report {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 8px 16px;
        background: #64748b; color: white;
        border-radius: var(--radius-sm);
        font-size: 13px; font-weight: 600;
        transition: all .2s;
        text-decoration: none;
    }
    .btn-print-report:hover { background: #475569; transform: translateY(-2px); }

    .empty-state {
        text-align: center; padding: 70px 20px; color: var(--text-muted);
    }
    .empty-state i { font-size: 56px; display: block; margin-bottom: 16px; opacity: .25; }
    .empty-state p  { font-size: 15px; }

    @* Expand CBC row *@
    .cbc-expanded-row td {
        background: #f8fafc;
        padding: 16px 24px;
        border-bottom: 1px solid var(--border-color);
    }
    .cbc-expanded-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 12px;
    }
    .cbc-stat {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        padding: 10px 14px;
    }
    .cbc-stat .label { font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; }
    .cbc-stat .value { font-size: 18px; font-weight: 700; color: var(--text-primary); margin-top: 2px; }
    .cbc-stat .unit  { font-size: 11px; color: var(--text-muted); }
</style>
}

<div class="container">
    @await Html.PartialAsync("_Sidebar")

    <div class="main-content">

        <div class="header">
            <div>
                <h1><i class="fa-solid fa-file-waveform" style="color:var(--primary-color);font-size:22px;margin-right:10px;"></i>Patient Reports</h1>
                <div style="font-size:13px;color:var(--text-muted);margin-top:3px;">
                    All completed reports — search and edit CBC values or diagnosis.
                </div>
            </div>
            <div class="header-right">
                <a href="@Url.Action("Pending")" style="display:inline-flex;align-items:center;gap:8px;color:var(--primary-color);font-weight:600;font-size:14px;">
                    <i class="fa-solid fa-clock"></i> Pending Reports
                </a>
                <div class="user-icon">
                    <i class="fa-solid fa-user-doctor"></i>
                    <span>Dr. @user?.Name</span>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert-success"><i class="fa-solid fa-check-circle"></i> @TempData["Success"]</div>
        }

        <div class="search-bar-wrap">
            <div class="search-box">
                <input type="text" id="searchInput"
                       placeholder="Search by patient name or ID…"
                       autocomplete="off" />
                <span class="close-icon" onclick="clearSearch()">
                    <i class="fa-solid fa-xmark"></i>
                </span>
            </div>
            <div id="searchStatus" style="font-size:13px;color:var(--text-muted);white-space:nowrap;min-width:100px;"></div>
            <div style="font-size:13px;color:var(--text-muted);">
                <strong id="shownCount">@list.Count</strong> of <strong>@total</strong> reports
            </div>
        </div>

        <div class="table-container" style="padding:0;overflow:hidden;">
            <table id="reportsTable">
                <thead>
                    <tr>
                        <th style="width:50px;"></th>
                        <th>Report ID</th>
                        <th>Patient</th>
                        <th>Age</th>
                        <th>Phone</th>
                        <th>Diagnosis</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @foreach (var r in list)
                    {
                        <tr class="report-row" data-report-id="@r.ReportId">
                            <td>
                                <button class="action-view" style="border:none;background:rgba(59,130,246,.1);width:32px;height:32px;border-radius:8px;cursor:pointer;color:#3b82f6;"
                                        onclick="toggleCbc(@r.ReportId)" title="Show CBC values">
                                    <i class="fa-solid fa-chevron-down" id="chevron-@r.ReportId"></i>
                                </button>
                            </td>
                            <td><span class="report-id-chip">#@r.ReportId.ToString("D3")</span></td>
                            <td>
                                <div style="font-weight:600;">@r.PatientName</div>
                                <div><span class="id-chip" style="margin-top:3px;display:inline-block;">#@r.PatientId.ToString("D3")</span></div>
                            </td>
                            <td>@r.PatientAge</td>
                            <td style="color:var(--text-secondary);">@(r.PatientPhone ?? "-")</td>
                            <td>
                                <span class="diag-chip" title="@r.Diagnosis">
                                    <i class="fa-solid fa-stethoscope" style="font-size:10px;"></i>
                                    @r.Diagnosis
                                </span>
                            </td>
                            <td style="color:var(--text-secondary);font-size:13px;">
                                @(r.PatientDate.HasValue ? r.PatientDate.Value.ToString("MMM dd, yyyy") : "-")
                            </td>
                            <td>
                                <div style="display:flex;gap:6px;align-items:center;">
                                    <a href="@Url.Action("EditReport","Reports",new{id=r.ReportId})" class="btn-edit-report">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </a>
                                    <a href="@Url.Action("Print","Reports",new{id=r.PatientId})" class="btn-print-report">
                                        <i class="fa-solid fa-print"></i> Print
                                    </a>
                                </div>
                            </td>
                        </tr>
                        <tr class="cbc-expanded-row" id="cbc-row-@r.ReportId" style="display:none;">
                            <td colspan="8">
                                <div class="cbc-expanded-grid">
                                    <div class="cbc-stat">
                                        <div class="label">WBC</div>
                                        <div class="value">@r.WBC.ToString("F2")</div>
                                        <div class="unit">10³/µL</div>
                                    </div>
                                    <div class="cbc-stat">
                                        <div class="label">RBC</div>
                                        <div class="value">@r.RBC.ToString("F2")</div>
                                        <div class="unit">10⁶/µL</div>
                                    </div>
                                    <div class="cbc-stat">
                                        <div class="label">HGB</div>
                                        <div class="value">@r.HGB.ToString("F2")</div>
                                        <div class="unit">g/dL</div>
                                    </div>
                                    <div class="cbc-stat">
                                        <div class="label">HCT</div>
                                        <div class="value">@r.HCT.ToString("F2")</div>
                                        <div class="unit">%</div>
                                    </div>
                                    <div class="cbc-stat">
                                        <div class="label">MCV</div>
                                        <div class="value">@r.MCV.ToString("F2")</div>
                                        <div class="unit">fL</div>
                                    </div>
                                    <div class="cbc-stat">
                                        <div class="label">MCH</div>
                                        <div class="value">@r.MCH.ToString("F2")</div>
                                        <div class="unit">pg</div>
                                    </div>
                                    <div class="cbc-stat">
                                        <div class="label">MCHC</div>
                                        <div class="value">@r.MCHC.ToString("F2")</div>
                                        <div class="unit">g/dL</div>
                                    </div>
                                    <div class="cbc-stat">
                                        <div class="label">PLT</div>
                                        <div class="value">@r.PLT.ToString("F2")</div>
                                        <div class="unit">10³/µL</div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="empty-state" id="emptyState" style="display:none;">
                <i class="fa-solid fa-file-circle-xmark"></i>
                <p>No reports found matching your search.</p>
            </div>
        </div>

        @* Load More *@
        <div class="load-more-wrap" id="loadMoreWrap" style="display:@(hasMore ? "flex" : "none")">
            <button class="btn-load-more" id="loadMoreBtn" onclick="loadMore()">
                <i class="fa-solid fa-chevron-down"></i> Load 10 More
            </button>
        </div>

    </div>
</div>

@section Scripts {
<script>
    let currentOffset = @(offset + pageSize);
    const PAGE_SIZE   = @pageSize;
    let searchTimer   = null;
    let isSearching   = false;

    const searchInput  = document.getElementById('searchInput');
    const tableBody    = document.getElementById('tableBody');
    const loadMoreWrap = document.getElementById('loadMoreWrap');
    const shownCount   = document.getElementById('shownCount');
    const emptyState   = document.getElementById('emptyState');
    const searchStatus = document.getElementById('searchStatus');
    const table        = document.getElementById('reportsTable');

    /* ── CBC expand/collapse ── */
    function toggleCbc(reportId) {
        const row     = document.getElementById(`cbc-row-${reportId}`);
        const chevron = document.getElementById(`chevron-${reportId}`);
        const open    = row.style.display === '';
        row.style.display     = open ? 'none' : '';
        chevron.className     = open
            ? 'fa-solid fa-chevron-down'
            : 'fa-solid fa-chevron-up';
    }

    /* ── Search ── */
    searchInput.addEventListener('input', () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(doSearch, 280);
    });

    async function doSearch() {
        const q = searchInput.value.trim();
        isSearching = q.length > 0;

        if (!isSearching) { clearSearch(); return; }

        searchStatus.textContent = 'Searching…';
        loadMoreWrap.style.display = 'none';

        try {
            const resp = await fetch(`/Reports/SearchReports?q=${encodeURIComponent(q)}`);
            const data = await resp.json();
            renderRows(data.reports, false);
            searchStatus.textContent = data.reports.length ? `${data.reports.length} result(s)` : 'No results';
            shownCount.textContent = data.reports.length;
        } catch {
            searchStatus.textContent = 'Search failed.';
        }
    }

    function clearSearch() {
        searchInput.value = '';
        isSearching = false;
        searchStatus.textContent = '';
        location.reload();
    }

    /* ── Load More ── */
    async function loadMore() {
        if (isSearching) return;
        const btn = document.getElementById('loadMoreBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Loading…';

        try {
            const resp = await fetch(`/Reports/SearchReports?q=&offset=${currentOffset}`);
            const data = await resp.json();
            renderRows(data.reports, true);
            currentOffset += data.reports.length;
            loadMoreWrap.style.display = data.hasMore ? 'flex' : 'none';
        } catch (e) { console.error(e); }

        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-chevron-down"></i> Load 10 More';
    }

    /* ── Render rows ── */
    function renderRows(reports, append) {
        if (!append) tableBody.innerHTML = '';

        reports.forEach(r => {
            const rId = String(r.reportId).padStart(3, '0');
            const pId = String(r.patientId).padStart(3, '0');

            tableBody.insertAdjacentHTML('beforeend', `
                <tr class="report-row" data-report-id="${r.reportId}">
                    <td>
                        <button class="action-view" style="border:none;background:rgba(59,130,246,.1);width:32px;height:32px;border-radius:8px;cursor:pointer;color:#3b82f6;"
                                onclick="toggleCbc(${r.reportId})" title="Show CBC values">
                            <i class="fa-solid fa-chevron-down" id="chevron-${r.reportId}"></i>
                        </button>
                    </td>
                    <td><span class="report-id-chip">#${rId}</span></td>
                    <td>
                        <div style="font-weight:600;">${esc(r.patientName)}</div>
                        <span class="id-chip" style="margin-top:3px;display:inline-block;">#${pId}</span>
                    </td>
                    <td>${r.patientAge}</td>
                    <td style="color:var(--text-secondary);">${esc(r.patientPhone ?? '-')}</td>
                    <td><span class="diag-chip" title="${esc(r.diagnosis)}"><i class="fa-solid fa-stethoscope" style="font-size:10px;"></i> ${esc(r.diagnosis)}</span></td>
                    <td style="color:var(--text-secondary);font-size:13px;">${esc(r.patientDate)}</td>
                    <td>
                        <div style="display:flex;gap:6px;align-items:center;">
                            <a href="/Reports/EditReport/${r.reportId}" class="btn-edit-report"><i class="fa-solid fa-pen-to-square"></i> Edit</a>
                            <a href="/Reports/Print/${r.patientId}" class="btn-print-report"><i class="fa-solid fa-print"></i> Print</a>
                        </div>
                    </td>
                </tr>
                <tr class="cbc-expanded-row" id="cbc-row-${r.reportId}" style="display:none;">
                    <td colspan="8">
                        <div class="cbc-expanded-grid">
                            ${cbcCard('WBC', r.wbc, '10³/µL')}
                            ${cbcCard('RBC', r.rbc, '10⁶/µL')}
                            ${cbcCard('HGB', r.hgb, 'g/dL')}
                            ${cbcCard('HCT', r.hct, '%')}
                            ${cbcCard('MCV', r.mcv, 'fL')}
                            ${cbcCard('MCH', r.mch, 'pg')}
                            ${cbcCard('MCHC', r.mchc, 'g/dL')}
                            ${cbcCard('PLT', r.plt, '10³/µL')}
                        </div>
                    </td>
                </tr>`);
        });

        const rows = tableBody.querySelectorAll('.report-row').length;
        shownCount.textContent    = rows;
        emptyState.style.display  = rows === 0 ? 'block' : 'none';
        table.style.display       = rows === 0 ? 'none'  : '';
    }

    function cbcCard(label, value, unit) {
        return `<div class="cbc-stat">
            <div class="label">${label}</div>
            <div class="value">${parseFloat(value).toFixed(2)}</div>
            <div class="unit">${unit}</div>
        </div>`;
    }

    function esc(str) {
        if (!str) return '-';
        const d = document.createElement('div');
        d.textContent = str;
        return d.innerHTML;
    }
</script>
}
