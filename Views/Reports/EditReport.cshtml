@using HemaSense.Models
@model Report
@{
    ViewData["Title"] = "Edit Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var user       = ViewBag.User as SessionUser;
    var predictUrl = Url.Action("Predict", "Reports");
}

@section Styles {
<link rel="stylesheet" href="~/css/app.css" />
<style>
    .patient-banner {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        border-radius: var(--radius-lg);
        padding: 24px 32px;
        color: white;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }
    .patient-banner .banner-title {
        font-size: 13px;
        font-weight: 600;
        opacity: .75;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 4px;
    }
    .patient-banner .banner-value { font-size: 20px; font-weight: 700; }
    .patient-banner .banner-grid {
        display: flex; gap: 40px; flex-wrap: wrap;
    }
    .report-id-badge {
        background: rgba(255,255,255,.2);
        border: 1px solid rgba(255,255,255,.35);
        border-radius: var(--radius-md);
        padding: 8px 18px;
        font-size: 15px;
        font-weight: 700;
        backdrop-filter: blur(4px);
        white-space: nowrap;
    }

    .cbc-section {
        background: white;
        padding: 36px;
        border-radius: var(--radius-lg);
        margin-bottom: 24px;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-color);
    }
    .cbc-section h2 {
        font-size: 20px; font-weight: 700; color: var(--text-primary);
        margin-bottom: 28px; padding-bottom: 16px;
        border-bottom: 1px solid var(--border-color);
        display: flex; align-items: center; gap: 12px;
    }
    .cbc-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 24px; }
    .cbc-input-group { display: flex; flex-direction: column; gap: 8px; }
    .cbc-input-group label {
        font-size: 14px; font-weight: 600; color: var(--text-primary);
        display: flex; align-items: center; justify-content: space-between;
    }
    .unit {
        font-size: 12px; color: #94a3b8;
        background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-weight: 400;
    }
    .cbc-input-group input {
        padding: 12px 16px; border: 1px solid var(--border-color);
        border-radius: var(--radius-md); font-size: 16px; transition: all .2s;
        background: white;
    }
    .cbc-input-group input:focus {
        outline: none; border-color: var(--primary-color); box-shadow: 0 0 0 3px var(--primary-light);
    }

    .action-footer {
        display: flex; gap: 14px; justify-content: flex-end;
        flex-wrap: wrap; margin-top: 36px; padding-top: 24px;
        border-top: 1px solid var(--border-color);
    }
    .action-btn {
        display: flex; align-items: center; gap: 10px;
        padding: 13px 24px; border: none; border-radius: var(--radius-md);
        font-size: 15px; font-weight: 600; cursor: pointer; transition: all .2s;
        color: white; text-decoration: none;
    }
    .btn-predict { background: #3b82f6; box-shadow: 0 4px 6px -1px rgba(59,130,246,.4); }
    .btn-predict:hover  { background: #2563eb; transform: translateY(-2px); }
    .btn-save    { background: #10b981; }
    .btn-save:hover     { background: #059669; transform: translateY(-2px); }
    .btn-cancel  { background: #64748b; }
    .btn-cancel:hover   { background: #475569; transform: translateY(-1px); }
    .btn-print   { background: white; color: var(--text-primary); border: 1.5px solid var(--border-color); }
    .btn-print:hover    { background: #f8fafc; }

    /* Prediction Modal */
    .prediction-modal {
        display: none; position: fixed; z-index: 1000; inset: 0;
        background: rgba(0,0,0,.5); backdrop-filter: blur(4px);
        align-items: center; justify-content: center;
    }
    .prediction-modal.show { display: flex; }
    .prediction-content {
        background: white; padding: 40px; border-radius: 24px;
        max-width: 480px; width: 90%; text-align: center;
        animation: fadeInUp .35s ease-out;
    }
    @@keyframes fadeInUp { from { opacity:0; transform:translateY(30px); } to { opacity:1; transform:translateY(0); } }
    .prediction-icon { font-size: 60px; color: #3b82f6; margin-bottom: 16px; }
    .diagnosis-label { font-size: 20px; font-weight: 700; padding: 12px 24px; border-radius: 12px; display: inline-block; margin: 12px 0; }
    .diagnosis-normal   { background: #dcfce7; color: #166534; }
    .diagnosis-warning  { background: #fef3c7; color: #92400e; }
    .diagnosis-critical { background: #fee2e2; color: #b91c1c; }
    .confidence-bar { width: 100%; height: 8px; background: #e2e8f0; border-radius: 4px; overflow: hidden; margin: 16px 0; }
    .confidence-fill { height: 100%; background: #3b82f6; transition: width .6s ease; }
    .confidence-text { font-size: 15px; font-weight: 600; color: #3b82f6; margin-bottom: 16px; }
    .modal-btn-row { display: flex; gap: 10px; justify-content: center; margin-top: 8px; }
    .close-modal-btn { padding: 12px 28px; background: #f1f5f9; border: none; border-radius: 12px; font-size: 15px; font-weight: 600; cursor: pointer; color: #1e293b; }
    .use-diagnosis-btn { padding: 12px 28px; background: #10b981; border: none; border-radius: 12px; font-size: 15px; font-weight: 600; cursor: pointer; color: white; }
    .use-diagnosis-btn:hover { background: #059669; }

    .loading-spinner-lg {
        width: 50px; height: 50px; border: 4px solid #f3f3f3;
        border-top: 4px solid #3b82f6; border-radius: 50%;
        animation: spin 1s linear infinite; margin: 0 auto;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    @@media (max-width: 768px) { .cbc-grid { grid-template-columns: 1fr; } }
</style>
}

<div class="container">
    @await Html.PartialAsync("_Sidebar")

    <div class="main-content">

        <div class="header">
            <h1><i class="fa-solid fa-file-pen" style="color:var(--primary-color);font-size:22px;margin-right:10px;"></i>Edit Report</h1>
            <div class="header-right">
                <a href="@Url.Action("OldReports")" style="color:var(--primary-color);font-weight:600;font-size:14px;display:inline-flex;align-items:center;gap:8px;">
                    <i class="fa-solid fa-arrow-left"></i> Back to Reports
                </a>
                <div class="user-icon">
                    <i class="fa-solid fa-user-doctor"></i>
                    <span>Dr. @user?.Name</span>
                </div>
            </div>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert-danger"><i class="fa-solid fa-triangle-exclamation"></i> @TempData["Error"]</div>
        }

        <div class="patient-banner">
            <div class="banner-grid">
                <div>
                    <div class="banner-title">Patient</div>
                    <div class="banner-value">@Model.PatientName</div>
                </div>
                <div>
                    <div class="banner-title">Patient ID</div>
                    <div class="banner-value">#@Model.PatientId.ToString("D3")</div>
                </div>
                <div>
                    <div class="banner-title">Age</div>
                    <div class="banner-value">@Model.PatientAge yrs</div>
                </div>
                <div>
                    <div class="banner-title">Phone</div>
                    <div class="banner-value">@(Model.PatientPhone ?? "-")</div>
                </div>
                @if (Model.PatientDate.HasValue)
                {
                    <div>
                        <div class="banner-title">Date</div>
                        <div class="banner-value">@Model.PatientDate.Value.ToString("MMM dd, yyyy")</div>
                    </div>
                }
            </div>
            <div class="report-id-badge">
                <i class="fa-solid fa-file-waveform" style="margin-right:7px;"></i>Report #@Model.ReportId.ToString("D3")
            </div>
        </div>

        <form asp-action="EditReport" asp-controller="Reports" asp-route-id="@Model.ReportId" method="post" id="reportForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReportId" />
            <input type="hidden" asp-for="PatientId" />

            <div class="cbc-section">
                <h2><i class="fa-solid fa-flask" style="color:var(--primary-color);"></i> CBC Values — Edit &amp; Update</h2>

                <div class="cbc-grid">
                    <div class="cbc-input-group">
                        <label asp-for="WBC">WBC <span class="unit">10³/µL</span></label>
                        <input asp-for="WBC" type="number" step="0.01" id="inp_wbc" />
                        <span asp-validation-for="WBC" class="text-danger"></span>
                    </div>
                    <div class="cbc-input-group">
                        <label asp-for="RBC">RBC <span class="unit">10⁶/µL</span></label>
                        <input asp-for="RBC" type="number" step="0.01" id="inp_rbc" />
                        <span asp-validation-for="RBC" class="text-danger"></span>
                    </div>
                    <div class="cbc-input-group">
                        <label asp-for="HGB">HGB <span class="unit">g/dL</span></label>
                        <input asp-for="HGB" type="number" step="0.01" id="inp_hgb" />
                        <span asp-validation-for="HGB" class="text-danger"></span>
                    </div>
                    <div class="cbc-input-group">
                        <label asp-for="HCT">HCT <span class="unit">%</span></label>
                        <input asp-for="HCT" type="number" step="0.01" id="inp_hct" />
                        <span asp-validation-for="HCT" class="text-danger"></span>
                    </div>
                    <div class="cbc-input-group">
                        <label asp-for="MCV">MCV <span class="unit">fL</span></label>
                        <input asp-for="MCV" type="number" step="0.01" id="inp_mcv" />
                        <span asp-validation-for="MCV" class="text-danger"></span>
                    </div>
                    <div class="cbc-input-group">
                        <label asp-for="MCH">MCH <span class="unit">pg</span></label>
                        <input asp-for="MCH" type="number" step="0.01" id="inp_mch" />
                        <span asp-validation-for="MCH" class="text-danger"></span>
                    </div>
                    <div class="cbc-input-group">
                        <label asp-for="MCHC">MCHC <span class="unit">g/dL</span></label>
                        <input asp-for="MCHC" type="number" step="0.01" id="inp_mchc" />
                        <span asp-validation-for="MCHC" class="text-danger"></span>
                    </div>
                    <div class="cbc-input-group">
                        <label asp-for="PLT">PLT <span class="unit">10³/µL</span></label>
                        <input asp-for="PLT" type="number" step="0.01" id="inp_plt" />
                        <span asp-validation-for="PLT" class="text-danger"></span>
                    </div>
                </div>

                <div class="cbc-input-group" style="margin-top:24px;">
                    <label asp-for="Diagnosis">Diagnosis</label>
                    <input asp-for="Diagnosis" id="diagnosisInput" placeholder="Use 'Re-Predict' or enter manually" />
                    <span asp-validation-for="Diagnosis" class="text-danger"></span>
                </div>

                <div class="action-footer">
                    <button type="button" class="action-btn btn-predict" id="predictBtn">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> Re-Predict Diagnosis
                    </button>
                    <a href="@Url.Action("Print","Reports",new{id=Model.PatientId})" class="action-btn btn-print">
                        <i class="fa-solid fa-print"></i> Print
                    </a>
                    <a href="@Url.Action("OldReports")" class="action-btn btn-cancel">
                        <i class="fa-solid fa-xmark"></i> Cancel
                    </a>
                    <button type="submit" class="action-btn btn-save">
                        <i class="fa-solid fa-floppy-disk"></i> Save Changes
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="prediction-modal" id="predictionModal">
    <div class="prediction-content">
        <div id="loadingContent" style="padding:30px;">
            <div class="loading-spinner-lg"></div>
            <p style="margin-top:16px;color:#64748b;">Analyzing CBC values…</p>
        </div>
        <div id="predictionResult" style="display:none;">
            <div class="prediction-icon"><i class="fa-solid fa-microscope"></i></div>
            <h2>Diagnosis Result</h2>
            <div class="diagnosis-label diagnosis-normal" id="diagnosisLabel">Normal</div>
            <div class="confidence-text" id="confidenceText">Confidence: 95%</div>
            <div class="confidence-bar"><div class="confidence-fill" id="confidenceFill" style="width:95%"></div></div>
            <div class="modal-btn-row">
                <button class="close-modal-btn" id="closeModalBtn">Close</button>
                <button class="use-diagnosis-btn" id="useDiagnosisBtn">Use This Diagnosis</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
<script>
    const predictUrl  = '@predictUrl';
    let lastDiagnosis = '';

    document.getElementById('predictBtn').addEventListener('click', async () => {
        const data = {
            WBC:  parseFloat(document.getElementById('inp_wbc').value)  || 0,
            RBC:  parseFloat(document.getElementById('inp_rbc').value)  || 0,
            HGB:  parseFloat(document.getElementById('inp_hgb').value)  || 0,
            HCT:  parseFloat(document.getElementById('inp_hct').value)  || 0,
            MCV:  parseFloat(document.getElementById('inp_mcv').value)  || 0,
            MCH:  parseFloat(document.getElementById('inp_mch').value)  || 0,
            MCHC: parseFloat(document.getElementById('inp_mchc').value) || 0,
            PLT:  parseFloat(document.getElementById('inp_plt').value)  || 0,
        };
        showModal(true);
        try {
            const res  = await fetch(predictUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const json = await res.json();
            lastDiagnosis = json.diagnosis;

            const pct   = Math.round((json.confidence || 0) * 100);
            const label = document.getElementById('diagnosisLabel');
            label.textContent = json.diagnosis;
            label.className   = 'diagnosis-label ' + (pct >= 85 ? 'diagnosis-normal' : pct >= 70 ? 'diagnosis-warning' : 'diagnosis-critical');
            document.getElementById('confidenceText').textContent = `Confidence: ${pct}%`;
            document.getElementById('confidenceFill').style.width = `${pct}%`;
            showModal(false);
        } catch (err) {
            console.error(err);
            showModal(false, true);
        }
    });

    function showModal(loading) {
        document.getElementById('predictionModal').classList.add('show');
        document.getElementById('loadingContent').style.display  = loading ? 'block' : 'none';
        document.getElementById('predictionResult').style.display = loading ? 'none'  : 'block';
    }
    document.getElementById('closeModalBtn').addEventListener('click', () =>
        document.getElementById('predictionModal').classList.remove('show'));
    document.getElementById('useDiagnosisBtn').addEventListener('click', () => {
        document.getElementById('diagnosisInput').value = lastDiagnosis;
        document.getElementById('predictionModal').classList.remove('show');
    });
</script>
}
