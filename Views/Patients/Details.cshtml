@using HemaSense.Models
@model Patient
@{
    ViewData["Title"] = "Patient Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
<link rel="stylesheet" href="~/css/app.css" />
<style>
    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin: 20px 0;
    }
    .detail-item {
        padding: 16px;
        background: #f8fafc;
        border-radius: 8px;
        border-left: 3px solid #3b82f6;
    }
    .detail-label { font-size: 12px; color: #64748b; font-weight: 600; text-transform: uppercase; margin-bottom: 6px; }
    .detail-value { font-size: 18px; color: #1e293b; font-weight: 600; }
    .remaining-value { color: #ef4444; font-weight: 700; }
</style>
}

<div class="container">
    @await Html.PartialAsync("_Sidebar")
    <div class="main-content">
        <div class="header">
            <h1>Patient Information</h1>
            <div class="header-right">
                <a href="@Url.Action("Index")" style="color:#3b82f6;font-weight:600;text-decoration:none;display:flex;align-items:center;gap:8px;">
                    <i class="fa-solid fa-arrow-left"></i> Back to Patients
                </a>
            </div>
        </div>

        <div class="form-container">
            <div class="details-grid">
                <div class="detail-item">
                    <div class="detail-label">Patient ID</div>
                    <div class="detail-value">#@Model.PatientId.ToString("D3")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Full Name</div>
                    <div class="detail-value">@Model.Name</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Age</div>
                    <div class="detail-value">@Model.Age years</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Phone Number</div>
                    <div class="detail-value">@Model.Phone</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Secretary</div>
                    <div class="detail-value">@(Model.SecretaryName ?? "-")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Registration Date</div>
                    <div class="detail-value">@(Model.NowDate.HasValue ? Model.NowDate.Value.ToString("MMM dd, yyyy") : "-")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Total Cost</div>
                    <div class="detail-value">$@Model.TotalPayment.ToString("F2")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Paid Amount</div>
                    <div class="detail-value" style="color:#10b981;">$@Model.PaidAmount.ToString("F2")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Remaining Balance</div>
                    <div class="detail-value remaining-value">$@Model.Remaining.ToString("F2")</div>
                </div>
            </div>

            <div class="form-actions">
                <a href="@Url.Action("Index")" class="btn btn-clear"><i class="fa-solid fa-xmark"></i> Close</a>
                <a href="@Url.Action("Edit", new{id=Model.PatientId})" class="btn btn-register"><i class="fa-solid fa-pen-to-square"></i> Edit Patient</a>
            </div>
        </div>
    </div>
</div>
