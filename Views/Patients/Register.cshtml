@using HemaSense.Models
@model Patient
@{
    ViewData["Title"] = "Register Patient";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var user = ViewBag.User as SessionUser;
    var secretaries = ViewBag.Secretaries as IEnumerable<Secretary> ?? Enumerable.Empty<Secretary>();
}

@section Styles {
<link rel="stylesheet" href="~/css/app.css" />
}

<div class="container">
    @await Html.PartialAsync("_Sidebar")

    <div class="main-content">
        <div class="header">
            <h1>Register Patient</h1>
            <div class="header-right">
                <div class="user-icon"><i class="fa-solid fa-user"></i></div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert-success"><i class="fa-solid fa-check-circle"></i> @TempData["Success"]</div>
        }

        <div class="form-container">
            <form asp-action="Create" asp-controller="Patients" method="post">
                @Html.AntiForgeryToken()
                <div class="form-grid">
                    <div class="form-group">
                        <label asp-for="Name">Full Name</label>
                        <input asp-for="Name" placeholder="Enter patient name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Age">Age</label>
                        <input asp-for="Age" type="number" placeholder="Enter age" min="0" max="150" />
                        <span asp-validation-for="Age" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SecretaryId">Secretary</label>
                        <select asp-for="SecretaryId">
                            <option value="">Select Secretary</option>
                            @foreach (var sec in secretaries)
                            {
                                var selected = user?.Role == "secretary" && user.UserId == sec.SecretaryId;
                                <option value="@sec.SecretaryId" selected="@selected">@sec.Name</option>
                            }
                        </select>
                        <span asp-validation-for="SecretaryId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Phone">Phone Number</label>
                        <input asp-for="Phone" type="tel" placeholder="Enter phone number" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="TotalPayment">Total Payment ($)</label>
                        <input asp-for="TotalPayment" type="number" step="0.01" min="0" placeholder="0.00" />
                        <span asp-validation-for="TotalPayment" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-actions">
                    <a href="@Url.Action("Index")" class="btn btn-clear">
                        <i class="fa-solid fa-arrow-left"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-register">
                        <i class="fa-solid fa-user-plus"></i> Register Patient
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
